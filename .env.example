# Environment variables — copy to .env and fill in secrets
# NEVER commit .env to version control

# Database
DB_USER=evuser
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=ev_infra
DB_HOST=db
DB_PORT=5432

# Open Charge Map API key (obtain from https://openchargemap.org/site/develop)
OCM_API_KEY=YOUR_OCM_API_KEY_HERE

# Overpass API (default public mirror; replace with a local instance for heavy use)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Application
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# For production — set a strong JWT secret if adding auth later
# SECRET_KEY=CHANGE_ME
