# EV_Nirvana — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database ────────────────────────────────────────────────────────────────────
# Option A: Single connection string (Supabase / Neon / Railway)
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Option B: Individual vars (local Docker Compose — leave DATABASE_URL blank)
DB_USER=evuser
DB_PASSWORD=your_password_here
DB_HOST=db
DB_PORT=5432
DB_NAME=ev_infra

# ── External APIs ───────────────────────────────────────────────────────────────
OCM_API_KEY=your_open_charge_map_key     # https://openchargemap.org/site/develop
CARTO_API_KEY=your_carto_key             # https://carto.com/developers/basemaps
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── Application ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
